# ==============================================================================
# ORCHESTRA PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure all mandatory variables before deployment.
# In production, all placeholders must be replaced with strong, unique secrets.
# ==============================================================================

# Runtime Environment ("production", "development", or "test")
ENVIRONMENT=production

# Public Reverse Proxy Port on Host
ORCHESTRA_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Mandatory in Production)
# ------------------------------------------------------------------------------
POSTGRES_DB=orchestra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password_here
DATABASE_URL=postgresql+psycopg://postgres:replace_with_strong_postgres_password_here@postgres:5432/orchestra

# ------------------------------------------------------------------------------
# Redis Configuration (Mandatory for Sliding-Window Rate Limiting in Production)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_here
REDIS_URL=redis://:replace_with_strong_redis_password_here@redis:6379/0

# ------------------------------------------------------------------------------
# Security & Authentication (Mandatory in Production)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long. Never use weak or default values.
JWT_SECRET=replace_with_minimum_32_char_random_jwt_secret_key_here!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------------------
# Qdrant Vector Engine Configuration (Mandatory in Production)
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=orchestra_knowledge

# ------------------------------------------------------------------------------
# AI Provider Configuration (Multi-Vendor Architecture)
# ------------------------------------------------------------------------------
# LLM Provider: Supported values: "openai", "groq", "nvidia", "gemini", "openai_compatible", or "test" (offline only)
# Presets automatically configure canonical base URLs and default models:
#   - "openai": https://api.openai.com/v1 (default: gpt-4o-mini)
#   - "groq": https://api.groq.com/openai/v1 (default: llama-3.3-70b-versatile)
#   - "nvidia": https://integrate.api.nvidia.com/v1 (default: meta/llama-3.1-70b-instruct)
#   - "gemini": https://generativelanguage.googleapis.com/v1beta/openai (default: gemini-1.5-flash)
#   - "openai_compatible": Custom endpoint (e.g. local vLLM, Ollama, LM Studio)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_ai_provider_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_OUTPUT_TOKENS=2048

# Embedding Provider: Supported values: "openai_compatible", or "test" (offline only)
# IMPORTANT: Qdrant collection strictly enforces 1536 dimensions.
# Because Groq has no embeddings API, and Gemini/NVIDIA generate 768/1024 dims,
# EMBEDDING_PROVIDER is intentionally decoupled from LLM_PROVIDER.
# For production, specify a 1536-dim embedding service (e.g. OpenAI text-embedding-3-small or local TEI).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# Storage & Workspace Configuration
# ------------------------------------------------------------------------------
STORAGE_LOCAL_ROOT=/app/data/storage
WORKSPACE_BASE_DIR=/app/workspaces
