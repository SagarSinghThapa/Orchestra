# ==============================================================================
# ORCHESTRA PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure all mandatory variables before deployment.
# In production, all placeholders must be replaced with strong, unique secrets.
# ==============================================================================

# Runtime Environment ("production", "development", or "test")
ENVIRONMENT=production

# Public Reverse Proxy Port on Host
ORCHESTRA_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Mandatory in Production)
# ------------------------------------------------------------------------------
POSTGRES_DB=orchestra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password_here
DATABASE_URL=postgresql+psycopg://postgres:replace_with_strong_postgres_password_here@postgres:5432/orchestra

# ------------------------------------------------------------------------------
# Redis Configuration (Mandatory for Sliding-Window Rate Limiting in Production)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_here
REDIS_URL=redis://:replace_with_strong_redis_password_here@redis:6379/0

# ------------------------------------------------------------------------------
# Security & Authentication (Mandatory in Production)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long. Never use weak or default values.
JWT_SECRET=replace_with_minimum_32_char_random_jwt_secret_key_here!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ------------------------------------------------------------------------------
# Qdrant Vector Engine Configuration (Mandatory in Production)
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=orchestra_knowledge

# ------------------------------------------------------------------------------
# AI Provider Configuration (Mandatory in Production: "openai_compatible")
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_OUTPUT_TOKENS=2048

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=your_openai_or_compatible_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# Storage & Workspace Configuration
# ------------------------------------------------------------------------------
STORAGE_LOCAL_ROOT=/app/data/storage
WORKSPACE_BASE_DIR=/app/workspaces
